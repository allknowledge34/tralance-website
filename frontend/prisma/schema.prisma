generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User Authentication (NextAuth)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  entitlements      Entitlement[]
  toolData          ToolData[]
  userNotifications UserNotification[]

  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// E-commerce & Entitlements (Cashfree)
// ==========================================

model Order {
  id                String   @id @default(cuid())
  userId            String
  planId            String   // 'monthly' | 'yearly' | 'single_tool' | 'pro'
  toolId            String?
  amount            Int
  currency          String   @default("INR")
  cashfreePaymentId String?  @unique
  cashfreeSignature String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  planId    String    // 'monthly' | 'yearly' | 'pro'
  toolId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, toolId])
  @@index([expiresAt])
}

// ==========================================
// Tool Data & Usage Storage
// ==========================================

model ToolData {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model PdfUsage {
  id           String   @id @default(cuid())
  identifier   String   @unique
  invoiceUses  Int      @default(0)
  briefUses    Int      @default(0)
  contractUses Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Content Models
// ==========================================

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  coverImage  String?
  content     String     @db.Text
  status      BlogStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
}

model PromoBarSettings {
  id        String   @id @default("global")
  isActive  Boolean  @default(false)
  text      String   @default("Try YTVoidMode — a cleaner YouTube experience for Chrome")
  btnText   String   @default("Try YTVoidMode")
  btnUrl    String   @default("https://chromewebstore.google.com/")
  icon      String   @default("sparkles")
  updatedAt DateTime @updatedAt
}

// ==========================================
// Notifications Center
// ==========================================

enum NotificationAudience {
  ALL
  PRO
  FREE
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

enum NotificationType {
  INFO
  ANNOUNCEMENT
  SUCCESS
  WARNING
}

model AdminNotification {
  id             String               @id @default(cuid())
  title          String
  message        String               @db.Text
  actionUrl      String?
  targetAudience NotificationAudience @default(ALL)
  type           NotificationType     @default(INFO)
  status         NotificationStatus   @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  userNotifications UserNotification[]

  @@index([status])
  @@index([createdAt])
}

model UserNotification {
  id             String            @id @default(cuid())
  userId         String
  notificationId String
  title          String
  message        String            @db.Text
  actionUrl      String?
  type           NotificationType  @default(INFO)
  isRead         Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==========================================
// Email Broadcast System
// ==========================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model EmailCampaign {
  id              String               @id @default(cuid())
  name            String
  subject         String
  senderName      String               @default("Tralance Team")
  senderEmail     String               @default("noreply@tralance.pro")
  previewText     String?
  htmlContent     String               @db.Text
  targetAudience  NotificationAudience @default(ALL)
  recipientType   String               @default("ALL_REGISTERED") // "ALL_REGISTERED", "PRO_REGISTERED", "FREE_REGISTERED", "SELECTED_USERS", "CUSTOM"
  customEmails    String?              @db.Text                   // JSON array of normalized email strings
  status          CampaignStatus       @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  errorDetails    String?              @db.Text
  isTest          Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  recipientLogs   EmailRecipientLog[]

  @@index([status])
  @@index([createdAt])
}

model EmailRecipientLog {
  id          String   @id @default(cuid())
  campaignId  String
  email       String
  messageId   String?  // Resend ID e.g. "re_123"
  status      String   @default("QUEUED") // QUEUED, SENT, DELIVERED, BOUNCED, FAILED
  error       String?  @db.Text
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
  @@index([status])
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   @default("UNSUBSCRIBE")
  createdAt DateTime @default(now())

  @@index([email])
}

// ==========================================
// System Audit Logs & Settings
// ==========================================

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  adminEmail String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
