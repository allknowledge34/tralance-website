generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  coverImage  String?
  content     String     @db.Text
  status      BlogStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  // Indexes for optimizing searches and sorting
  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
}

model PromoBarSettings {
  id           String   @id @default("global")
  isActive     Boolean  @default(false)
  text         String   @default("Try YTVoidMode — a cleaner YouTube experience for Chrome")
  btnText      String   @default("Try YTVoidMode")
  btnUrl       String   @default("https://chromewebstore.google.com/")
  icon         String   @default("sparkles")
  updatedAt    DateTime @updatedAt
}
